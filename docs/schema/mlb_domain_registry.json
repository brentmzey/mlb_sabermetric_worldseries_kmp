{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MLB Sabermetric World Series Domain Registry",
  "description": "Canonical cross-language schema and registry for MLB teams, leagues, divisions, sabermetric statistical pillars, playoff series structures, and database collection models.",
  "version": "2026.1.0",
  "leagues": [
    {
      "code": "AL",
      "name": "American League",
      "foundedYear": 1901
    },
    {
      "code": "NL",
      "name": "National League",
      "foundedYear": 1876
    }
  ],
  "divisions": [
    {
      "code": "EAST",
      "name": "East Division"
    },
    {
      "code": "CENTRAL",
      "name": "Central Division"
    },
    {
      "code": "WEST",
      "name": "West Division"
    }
  ],
  "stat_pillars": [
    {
      "code": "OFFENSE",
      "name": "Offensive Run Creation",
      "weight": 0.25,
      "primaryMetric": "wRC+",
      "secondaryMetric": "wOBA",
      "description": "Evaluates Park-Adjusted Weighted Runs Created Plus and on-base weighted outcomes."
    },
    {
      "code": "DEFENSE",
      "name": "Defensive Efficiency & Run Prevention",
      "weight": 0.15,
      "primaryMetric": "Defensive_Efficiency",
      "secondaryMetric": "OAA_DRS",
      "description": "Evaluates run conversion suppression, Outs Above Average (OAA), and Defensive Runs Saved (DRS)."
    },
    {
      "code": "STARTING_PITCHING",
      "name": "Top-3 Starting Rotation Ace Quality",
      "weight": 0.35,
      "primaryMetric": "Top3_Ace_ERA",
      "secondaryMetric": "FIP",
      "description": "Postseason compressed rotation effectiveness of top 3 starting pitchers."
    },
    {
      "code": "BULLPEN_LEVERAGE",
      "name": "Bullpen High-Leverage Reliability",
      "weight": 0.25,
      "primaryMetric": "Bullpen_WPA",
      "secondaryMetric": "xFIP",
      "description": "Evaluates late-inning Win Probability Added (WPA) and high-leverage strikeout sustainability."
    }
  ],
  "postseason_rounds": [
    {
      "code": "WILD_CARD",
      "name": "Wild Card Series",
      "bestOf": 3,
      "winsToAdvance": 2,
      "homeFieldFormat": "2-1"
    },
    {
      "code": "DIVISION_SERIES",
      "name": "Division Series (LDS)",
      "bestOf": 5,
      "winsToAdvance": 3,
      "homeFieldFormat": "2-2-1"
    },
    {
      "code": "LEAGUE_CHAMPIONSHIP",
      "name": "League Championship Series (LCS)",
      "bestOf": 7,
      "winsToAdvance": 4,
      "homeFieldFormat": "2-3-2"
    },
    {
      "code": "WORLD_SERIES",
      "name": "World Series (Fall Classic)",
      "bestOf": 7,
      "winsToAdvance": 4,
      "homeFieldFormat": "2-3-2"
    }
  ],
  "hungarian_prefixes": [
    {
      "prefix": "i_",
      "category": "INPUT",
      "description": "Immutable, raw time-series inputs ingested from external APIs, market sportsbooks, and consensus models."
    },
    {
      "prefix": "m_",
      "category": "MODEL",
      "description": "Intermediate latent metrics, 2SLS causal estimates, Bayesian adjusted indices, and four-pillar composites."
    },
    {
      "prefix": "s_",
      "category": "SUMMARY",
      "description": "Materialized aggregations for divisional standings, league-wide quality benchmarks, and cross-division parity."
    },
    {
      "prefix": "o_",
      "category": "OUTPUT",
      "description": "Deterministic and stochastic simulation outputs, matchup matrix permutations, and rank velocity deltas."
    },
    {
      "prefix": "f_",
      "category": "FINAL",
      "description": "Final customer-facing World Series championship probabilities, sensitivity scenarios, and high-res chart endpoints."
    }
  ],
  "record_status_codes": [
    {
      "code": "ACTIVE",
      "description": "Currently authoritative active record for model selection and visual rendering."
    },
    {
      "code": "INACTIVE",
      "description": "Temporarily disabled or non-authoritative record."
    },
    {
      "code": "SUPERSEDED",
      "description": "Historical record replaced by a newer update in time series."
    },
    {
      "code": "ARCHIVED",
      "description": "Cold-storage historical snapshot preserved for multi-year panel analysis."
    }
  ],
